        </mxCell>

        <mxCell id="formula1-eq" value="a_t = (1-t)×noise + t×a_gt" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;" vertex="1" parent="1">
